# Local development configuration only. This stack requires no credentials.
COMPOSE_PROJECT_NAME=ttod_oracle
HTTP_PORT=8080
ALT_HTTP_PORT=8443

# The app runs its own Ollama container by default — nothing to install, `make up`
# just works. This is the one supported, documented path (what students use).
OLLAMA_MODE=container
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTAINER_PORT=11435

# Advanced, personal override — not a `make` target, not diagrammed: point the app at
# an Ollama you already run yourself (e.g. for GPU speed outside Docker on macOS,
# where Docker has no Metal passthrough). Uncomment and adjust if you want this:
# OLLAMA_MODE=host
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=<your own already-pulled model>

# Advanced service paths/policy. These defaults match the container images.
TTOD_PATH=/workspace/ttod.yml
TTOD_SCHEMA_DIR=/workspace/schema
TTOD_PROPOSAL_DIR=/workspace/services/backend/data/proposals
# An ephemeral random signing key is generated if unset; set a stable 32-byte+ value for persistence.
TTOD_PAT_SECRET=
TTOD_PAT_TTL_SECONDS=3600
TTOD_ADMIN_EMAIL=admin@ttod.local
TTOD_ADMIN_PASSWORD_HASH=
# Generate a bcrypt hash without putting the password in shell history:
# python -c "from getpass import getpass; from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash(getpass()))"
ORACLE_RETRIEVAL_THRESHOLD=0.575
ORACLE_RETRIEVAL_TOP_K=5

# Optional, personal, IDE-only — NOT required to run the app (line 1 still holds for the
# stack itself). Only needed if you individually opt into the GitHub MCP server documented
# at agentic/ide-mcp/examples/github.json; leave unset otherwise. Never commit a real value —
# this file only ever holds the variable name. See AGENTIC-HARNESS.md "GitHub MCP: opt-in
# only" for why this server is never in the committed .cursor/mcp.json default.
# GITHUB_PERSONAL_ACCESS_TOKEN=
