---
import Page from '../../layouts/Page.astro';
import { isLocale } from '../../content/wisdom';
import { AUTH_COOKIE_NAME } from '../../lib/auth';
import type { AuthLoginResponse } from '../../types/domain';

export const prerender = false;

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

let loginError: 'credentials' | 'service' | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email');
  const password = formData.get('password');

  if (typeof email === 'string' && typeof password === 'string') {
    try {
      const backend = import.meta.env.BACKEND_URL ?? 'http://localhost:8000';
      const response = await fetch(`${backend}/api/v1/auth/login`, {
        method: 'POST',
        headers: { accept: 'application/json', 'content-type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      if (response.ok) {
        const result = await response.json() as AuthLoginResponse;
        if (
          typeof result.session_token === 'string' && result.session_token.length > 0 &&
          result.token_type === 'Session' &&
          typeof result.expires_in === 'number' && result.expires_in > 0 &&
          typeof result.user?.id === 'string' &&
          typeof result.user.email === 'string' &&
          (result.user.role === 'admin' || result.user.role === 'user') &&
          Array.isArray(result.user.roles) &&
          result.user.roles.every((role) => (
            role === 'student' || role === 'reviewer' || role === 'instructor'
          ))
        ) {
          Astro.cookies.set(AUTH_COOKIE_NAME, result.session_token, {
            httpOnly: true,
            sameSite: 'lax',
            secure: import.meta.env.PROD,
            path: '/',
            maxAge: result.expires_in
          });
          return Astro.redirect(`/${locale}/account`);
        }
        loginError = 'service';
      } else if (response.status === 401) {
        loginError = 'credentials';
      } else {
        loginError = 'service';
      }
    } catch {
      console.error('The authentication service could not complete the login request.');
      loginError = 'service';
    }
  } else {
    loginError = 'credentials';
  }

  loginError ??= 'credentials';
}

const copy = locale === 'es'
  ? {
      title: 'Iniciar sesión · TTOD',
      heading: 'Iniciar sesión',
      email: 'Correo electrónico',
      password: 'Contraseña',
      submit: 'Entrar',
      credentialsError: 'Las credenciales no son válidas.',
      serviceError: 'El servicio de autenticación no está disponible. Inténtalo de nuevo.'
    }
  : {
      title: 'Log in · TTOD',
      heading: 'Log in',
      email: 'Email',
      password: 'Password',
      submit: 'Log in',
      credentialsError: 'Invalid credentials.',
      serviceError: 'The authentication service is unavailable. Please try again.'
    };
---

<Page lang={locale} title={copy.title}>
  <main>
    <h1>{copy.heading}</h1>

    {loginError && <p role="alert">{loginError === 'credentials' ? copy.credentialsError : copy.serviceError}</p>}

    <form method="post">
      <p>
        <label for="email">{copy.email}</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </p>
      <p>
        <label for="password">{copy.password}</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
      </p>
      <button type="submit">{copy.submit}</button>
    </form>
  </main>
</Page>
